# Copy to .env. Never commit credentials.
AI_PROVIDER=codex
# Optional local runtime: set AI_PROVIDER=ollama and an installed GGUF model.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-model:tag
# OLLAMA_CONTEXT_SIZE=65536
# Optional override if codex.exe is not on PATH.
# CODEX_BIN=C:\path\to\codex.exe
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
# Requested model configuration: gpt-6-astra with low reasoning.
OPENAI_REASONING_EFFORT=low
# Use the app's audience instructions for this invocation only. 0 restores the previous preamble.
BACKSEAT_COMPACT_INSTRUCTIONS=1
# Codex shares identical witnessed context by default. Set 0 to restore repeated packets.
# Other hosted providers require explicit opt-in; local models are not qualified yet.
# BACKSEAT_SHARED_VIEWER_CONTEXT=0
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PORT=4318
