{
  "name": "nagneon",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "desktop": "npm run build && electron .",
    "test": "node --test test/*.test.js",
    "check": "npm run format:check && npm run test && npm run build",
    "package:windows": "npm run check && node scripts/package-windows.mjs",
    "format": "prettier --write src/App.tsx src/style.css src/types.ts server/studio.js server/index.js",
    "format:check": "prettier --check src/App.tsx src/style.css src/types.ts server/studio.js server/index.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "express": "^5.1.0",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^0.468.0",
    "obs-websocket-js": "5.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "3.0.1",
    "ws": "8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@openai/codex": "0.154.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.3.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "license": "MIT",
  "description": "AI 관객과 함께하는 개인 방송실 · Nagneon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msmckimgpt-tech/nagneon.git"
  }
}
