{
  "name": "nagneon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "desktop": "npm run build && electron .",
    "test": "node --test test/*.test.js",
    "check": "npm run test && npm run build",
    "package:windows": "npm run check && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@openai/codex": "0.154.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.3.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "license": "MIT",
  "description": "AI 관객과 함께하는 개인 방송실 · Nagneon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msmckimgpt-tech/nagneon.git"
  }
}
